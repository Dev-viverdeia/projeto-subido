# Copie para .env.local e preencha. Nomes validados em src/lib/env.ts — o app
# lança no boot, com o nome da variável, se alguma faltar ou estiver malformada.

# Supabase · Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://SEU_REF.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# Service role. NUNCA prefixe com NEXT_PUBLIC_ — o prefixo publica a chave no
# bundle do browser, e esta chave ignora RLS por completo.
SUPABASE_SECRET_KEY=sb_secret_...

# Autoriza somente o worker periódico que retoma operações interrompidas.
# Use pelo menos 32 caracteres aleatórios e configure o mesmo valor na Vercel.
CRON_SECRET=

# Origem pública. Em produção é o domínio real; entra no metadataBase e no
# redirect de e-mail de confirmação do Supabase.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Callback já autorizado no Google. Em produção pode apontar temporariamente
# para o alias técnico enquanto o domínio oficial passa pela homologação OAuth.
GOOGLE_CALENDAR_REDIRECT_URI=

# Stripe · somente servidor. Checkout só é habilitado quando a chave restrita,
# o segredo do webhook e os Price IDs correspondentes estão presentes.
# Prefira uma restricted key (rk_) com o mínimo de permissões necessário.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PORTAL_CONFIGURATION_ID=
STRIPE_PRICE_STARTER_MONTHLY=
STRIPE_PRICE_PRO_MONTHLY=
STRIPE_PRICE_CREDITS_ESSENCIAL=
STRIPE_PRICE_CREDITS_CRESCIMENTO=
STRIPE_PRICE_CREDITS_ESCALA=
STRIPE_CREDITOS_STARTER=30
STRIPE_CREDITOS_PRO=100

# Sobral AI · somente servidor Next/Vercel. Nunca use NEXT_PUBLIC_.
OPENAI_API_KEY=
SOBRAL_AI_MODEL=gpt-5.6-terra
LIVE_COACH_MODEL=gpt-5.6-luna

# LiveKit · somente servidor. Sem este trio a agenda continua ativa e a sala
# devolve indisponibilidade controlada, sem expor ou inventar credenciais.
LIVEKIT_URL=wss://SEU_PROJETO.livekit.cloud
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# ---------------------------------------------------------------------------
# ANTHROPIC_API_KEY *** NÃO VAI AQUI, NEM NA VERCEL ***
#
# Este arquivo tinha uma linha `ANTHROPIC_API_KEY=` e a instrução de repeti-la
# nas Environment Variables da Vercel. Estava desatualizada: a geração migrou
# para Edge Functions, e nenhum código do Next lê essa variável — confirmado por
# grep em src/ e proxy.ts. Quem a lê é `Deno.env.get('ANTHROPIC_API_KEY')` dentro
# de supabase/functions/, e o runtime Deno só enxerga o cofre do Supabase.
#
# Pôr a chave na Vercel não faz o Builder funcionar e ainda espalha o segredo por
# um cofre a mais. O lugar certo é UM só:
#   Supabase → Project Settings → Edge Functions → Secrets
# ---------------------------------------------------------------------------
