{
  "name": "plataforma-subido-viverdeia",
  "version": "0.1.0",
  "private": true,
  "packageManager": "npm@11.12.1",
  "engines": {
    "node": ">=24.15.0",
    "npm": ">=11"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "types:rotas": "next typegen",
    "typecheck": "next typegen && tsc --noEmit",
    "lint": "next typegen && eslint .",
    "lint:fix": "next typegen && eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "e2e": "playwright test",
    "db:push": "supabase db push",
    "db:types": "supabase gen types typescript --project-id fopljjqxituhajzwjrjt --schema public > src/lib/supabase/types.generated.ts",
    "vendor:via": "node scripts/vendor-via.mjs",
    "check:ds-drift": "node scripts/check-ds-drift.mjs",
    "check:lockfile": "node scripts/check-single-lockfile.mjs",
    "check:fronteira": "node scripts/check-client-boundary.mjs",
    "prepare": "husky",
    "check:identidade": "node scripts/check-design-tokens.mjs",
    "gen:schema-edge": "node scripts/gerar-schema-edge.mjs",
    "check:schema-edge": "node scripts/gerar-schema-edge.mjs --check",
    "check:edge": "deno check supabase/functions/builder/index.ts",
    "smoke:jornada-ouro": "node scripts/smoke-jornada-ouro.mjs",
    "deploy:edge": "npm run gen:schema-edge && supabase functions deploy builder --project-ref fopljjqxituhajzwjrjt",
    "check:conteudo-demo": "node scripts/check-conteudo-demo.mjs"
  },
  "lint-staged": {
    "*.{ts,tsx,mjs}": [
      "eslint --fix --no-warn-ignored",
      "prettier --write"
    ],
    "*.{css,json,md}": "prettier --write"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "0.115.0",
    "@dnd-kit/core": "6.3.1",
    "@livekit/components-react": "2.9.23",
    "@livekit/components-styles": "1.2.0",
    "@react-pdf/renderer": "4.5.1",
    "@supabase/ssr": "0.8.0",
    "@supabase/supabase-js": "2.110.9",
    "@tanstack/react-query": "5.101.4",
    "@vercel/analytics": "2.0.1",
    "@vercel/speed-insights": "2.0.0",
    "fflate": "0.8.2",
    "lenis": "1.3.25",
    "livekit-client": "2.21.0",
    "livekit-server-sdk": "2.17.0",
    "lucide-react": "1.27.0",
    "motion": "12.42.2",
    "next": "16.3.0",
    "openai": "7.4.0",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "server-only": "0.0.1",
    "tus-js-client": "4.3.1",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.12.1",
    "@eslint/js": "10.0.1",
    "@next/eslint-plugin-next": "16.3.0",
    "@playwright/test": "1.62.0",
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/react": "16.3.2",
    "@testing-library/user-event": "14.6.1",
    "@types/node": "24.13.3",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.4",
    "@vitest/coverage-v8": "4.1.10",
    "eslint": "10.8.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.8.0",
    "husky": "9.1.7",
    "jsdom": "29.1.1",
    "lint-staged": "17.2.0",
    "prettier": "3.9.6",
    "supabase": "2.110.0",
    "typescript": "5.9.3",
    "typescript-eslint": "8.65.0",
    "vitest": "4.1.10"
  }
}
